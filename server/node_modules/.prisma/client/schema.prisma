datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              Int           @id @default(autoincrement())
  nome            String
  email           String        @unique
  senha           String
  role            String        @default("cliente")
  telefone        String?
  endereco        String?
  crmv            String?
  especialidade   String?
  nivelAcesso     String?
  createdAt       DateTime      @default(now())
  pets            Pet[]         @relation("ClientPets")
  clientSchedules Schedule[]    @relation("ClientSchedules")
  vetSchedules    Schedule[]    @relation("VeterinarianSchedules")
  chatMessages    ChatMessage[]
}

model Pet {
  id             Int        @id @default(autoincrement())
  nome           String
  especie        String
  raca           String?
  idade          Float?
  peso           Float?
  dataNascimento DateTime?
  clienteId      Int
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now())
  cliente        User       @relation("ClientPets", fields: [clienteId], references: [id])
  schedules      Schedule[]
}

model Schedule {
  id             String   @id @default(uuid())
  clientId       Int
  petId          Int
  veterinarianId Int
  date           DateTime
  status         String   @default("scheduled")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client       User @relation("ClientSchedules", fields: [clientId], references: [id])
  pet          Pet  @relation(fields: [petId], references: [id])
  veterinarian User @relation("VeterinarianSchedules", fields: [veterinarianId], references: [id])

  @@unique([veterinarianId, date])
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    Int
  role      String   @default("user")
  message   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}
