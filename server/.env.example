# Porta do servidor (padrão: 4000)
PORT=4000

# Configuração do banco de dados para o Prisma
DATABASE_URL="file:./data/database.sqlite"

# Chave secreta JWT usada para autenticação
JWT_SECRET="newpet_super_secret"

# Desativa a integração com a OpenAI e usa o mock interno
DISABLE_OPENAI=true

# Outras configurações podem ser adicionadas aqui conforme necessário